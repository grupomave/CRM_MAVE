# Copie para .env.local e preencha com os dados do seu projeto Supabase
# (Project Settings > API no painel do Supabase).

NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJ...

# Somente para rotas server-side/edge functions que precisem ignorar RLS.
# NUNCA exponha esta chave ao navegador (não usar prefixo NEXT_PUBLIC_).
SUPABASE_SERVICE_ROLE_KEY=eyJ...
