# Copie para .env.local e preencha com os dados do seu projeto Supabase
# (Project Settings > API no painel do Supabase).

NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJ...

# Somente para rotas server-side/edge functions que precisem ignorar RLS.
# NUNCA exponha esta chave ao navegador (não usar prefixo NEXT_PUBLIC_).
SUPABASE_SERVICE_ROLE_KEY=eyJ...

# Resumo diário de atividades por e-mail (08:00, horário de Brasília).
# CRON_SECRET: segredo longo e aleatório; a Vercel o envia no cabeçalho
# Authorization do cron definido em vercel.json.
CRON_SECRET=
# E-mail (Resend, https://resend.com): domínio do remetente precisa estar verificado.
RESEND_API_KEY=
MAIL_FROM="CRM Grupo Mave <crm@seudominio.com.br>"
# URL pública do CRM, usada nos links dos e-mails.
NEXT_PUBLIC_APP_URL=https://seu-crm.vercel.app
